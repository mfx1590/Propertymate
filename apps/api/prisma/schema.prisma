// PropVerify — core schema (Plan.md §5)
// Conventions: cuid ids, snake_case table/column mapping, soft deletes via deleted_at,
// i18n text stored as jsonb {en, tr, ru, fa}.

generator client {
  provider      = "prisma-client-js"
  // "native" covers the developer machine; the debian target is what the
  // Docker image runs on (node:20-bookworm-slim). Without it the container
  // starts and then dies looking for a query engine it never generated.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── enums ───────────────────────────

enum UserStatus {
  active
  suspended
  banned
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum BadgeTier {
  unverified
  pending
  verified
  trusted_partner
}

enum AdminSubRole {
  super_admin
  verification_officer
  support_agent
  content_moderator
}

enum ServiceType {
  lawyer
  furniture
  movers
  insurance
  property_management
  notary_translation
}

enum VerificationContext {
  profile
  listing_resale
  listing_rental
  project
}

enum VerificationEntityType {
  profile
  listing
  project
  document
}

enum VerificationItemStatus {
  queued
  claimed
  approved
  rejected
}

enum DocumentStatus {
  pending
  approved
  rejected
}

enum RejectReasonCode {
  illegible
  expired
  name_mismatch
  wrong_type
  suspected_forgery
  other
}

enum PropertyKind {
  resale
  rental
}

enum PropertyStatus {
  draft
  pending_verification
  verified_private // resale approved but NOT public — awaiting agent assignment (§13.4)
  live
  paused
  under_offer
  sold
  rented
  archived
}

enum AssignmentStatus {
  invited
  accepted
  rejected
  expired
  cancelled
}

enum SubscriptionStatus {
  active
  cancelled
  expired
}

enum DeedType {
  turkish
  exchange
  allocation
  foreign
  na
}

enum MediaType {
  photo
  video
  tour360
}

enum ProjectStatus {
  draft
  pending_verification
  live
  paused
  archived
}

enum UnitStatus {
  available
  reserved
  sold
}

enum ViewingStatus {
  requested
  confirmed
  completed
  cancelled
  no_show
}

enum OfferStatus {
  submitted
  countered
  accepted
  rejected
  withdrawn
}

enum DealKind {
  purchase
  rental
}

enum DealStatus {
  active
  completed
  cancelled
}

enum StageStatus {
  pending
  active
  completed
  skipped
}

enum LegalEngagementStatus {
  requested
  quoted
  declined
  accepted
  withdrawn
}

enum DealPartyRole {
  buyer
  seller
  agent_buyer_side
  agent_seller_side
  lawyer
  service_provider
}

enum NotificationChannel {
  in_app
  push
  email
  whatsapp
}

enum AlertChannel {
  push
  email
  whatsapp
}

enum DisputeStatus {
  open
  investigating
  resolved_upheld
  resolved_dismissed
  withdrawn
}

/// Outcome of a reported review (Plan §13.2). `upheld` means the *message* was
/// removed — never the rating itself, so a profile owner cannot lift their
/// score by getting comments pulled.
enum ReviewReportStatus {
  open
  upheld
  dismissed
}

// ─────────────────────── users / roles / RBAC ───────────────────────

model User {
  id              String     @id @default(cuid())
  phone           String?    @unique
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  email           String?    @unique
  passwordHash    String?    @map("password_hash")
  locale          String     @default("en")
  /// Personal invite code (Plan §8). Assigned on first use, not at signup, so
  /// existing accounts get one the moment they open the referrals page.
  referralCode    String?    @unique @map("referral_code")
  avatarUrl       String?    @map("avatar_url")
  status          UserStatus @default(active)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  userRoles          UserRole[]
  adminProfile       AdminProfile?
  agentProfile       AgentProfile?
  agencyProfile      AgencyProfile?
  developerProfile   DeveloperProfile?
  ownerProfile       OwnerProfile?
  lawyerProfile      LawyerProfile?
  serviceProviders   ServiceProvider[]
  legalEngagementsAsLawyer    LegalEngagement[] @relation("LegalEngagementLawyer")
  legalEngagementsAsRequester LegalEngagement[] @relation("LegalEngagementRequester")
  documents          Document[]
  refreshTokens      RefreshToken[]
  otpCodes           OtpCode[]
  savedSearches      SavedSearch[]
  favorites          Favorite[]
  propertyViews      PropertyViewEvent[]
  notificationPrefs  NotificationPreference[]
  pushTokens         PushToken[]
  contractSignatures ContractSignature[]
  referralsMade      Referral[]                @relation("ReferralReferrer")
  referralReceived   Referral?                 @relation("ReferralReferee")
  featuredCredits    FeaturedCredit[]
  conversationsIn    ConversationParticipant[]
  messagesSent       Message[]
  viewingsAsCustomer Viewing[]                 @relation("ViewingCustomer")
  viewingsAsHost     Viewing[]                 @relation("ViewingHost")
  offersMade         Offer[]
  dealParties        DealParty[]
  ratingsGiven       Rating[]                  @relation("RatingRater")
  ratingsReceived    Rating[]                  @relation("RatingRatee")
  reviewReportsMade  ReviewReport[]            @relation("ReviewReportReporter")
  warnings           UserWarning[]             @relation("UserWarningTarget")
  bannedIdentities   BannedIdentity[]          @relation("BannedIdentityUser")
  notifications      Notification[]
  propertiesCreated  Property[]                @relation("PropertyCreator")
  propertiesOwned    Property[]                @relation("PropertyOwner")
  projects           Project[]
  agencyMemberships  AgencyAgent[]             @relation("AgencyMemberAgent")

  @@map("users")
}

model Role {
  id   String @id @default(cuid())
  key  String @unique
  name String

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  requirements    VerificationRequirement[]

  @@map("roles")
}

model Permission {
  id  String @id @default(cuid())
  key String @unique

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id                 String             @id @default(cuid())
  userId             String             @map("user_id")
  roleId             String             @map("role_id")
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  badgeTier          BadgeTier          @default(unverified) @map("badge_tier")
  createdAt          DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ─────────────────────── profile extensions (Plan §2.2) ───────────────────────

model AdminProfile {
  userId  String       @id @map("user_id")
  subRole AdminSubRole @map("sub_role")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model AgentProfile {
  userId             String    @id @map("user_id")
  licenseNo          String?   @map("license_no")
  bio                String?
  regions            String[]  @default([])
  responseTimeAvgSec Int?      @map("response_time_avg_sec")
  dealCount          Int       @default(0) @map("deal_count")
  ratingAvg          Float?    @map("rating_avg")
  /// Upheld disputes ÷ completed deals — the negative term of the ranking score.
  disputeRate        Float?    @map("dispute_rate")
  /// f(rating_avg, deal_count, response_time, dispute_rate) 0–100, nightly (§6.5).
  /// Boosts this lister's listings in search and orders the find-my-agent directory.
  rankingScore       Float?    @map("ranking_score")
  rankingComputedAt  DateTime? @map("ranking_computed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rankingScore])
  @@map("agent_profiles")
}

model AgencyProfile {
  userId      String  @id @map("user_id")
  companyName String  @map("company_name")
  regNo       String? @map("reg_no")
  taxNo       String? @map("tax_no")
  address     String?
  logoUrl     String? @map("logo_url")
  about       String?

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agents AgencyAgent[]

  @@map("agency_profiles")
}

model AgencyAgent {
  agencyId    String   @map("agency_id")
  agentUserId String   @map("agent_user_id")
  /// `org_admin` may manage the team alongside the agency account itself; `member` works listings only (§13.1).
  orgRole     String   @default("member") @map("org_role")
  /// `active` | `deactivated` — removal is a soft deactivate so closed deals keep their party history.
  status      String   @default("active")
  joinedAt    DateTime @default(now()) @map("joined_at")

  agency AgencyProfile @relation(fields: [agencyId], references: [userId], onDelete: Cascade)
  agent  User          @relation("AgencyMemberAgent", fields: [agentUserId], references: [id], onDelete: Cascade)

  @@id([agencyId, agentUserId])
  @@map("agency_agents")
}

model DeveloperProfile {
  userId        String  @id @map("user_id")
  companyName   String  @map("company_name")
  regNo         String? @map("reg_no")
  taxNo         String? @map("tax_no")
  portfolioJson Json?   @map("portfolio_json")
  about         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("developer_profiles")
}

model OwnerProfile {
  userId String @id @map("user_id")
  // thin at launch (Plan §5)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("owner_profiles")
}

/// The first lateral role to be activated (Plan §10.2 Phase 3, §2.2 profile extension).
/// Deliberately thin: it holds what a client picks a lawyer ON, and nothing that
/// only an unbuilt feature would write. Notably absent is a ranking score — the
/// §6.5 formula is built from listing-side inputs (deal count, response time on
/// property threads) that say nothing about legal work.
model LawyerProfile {
  userId    String   @id @map("user_id")
  firmName  String?  @map("firm_name")
  barNo     String?  @map("bar_no")
  bio       String?
  regions   String[] @default([])
  /// Locale keys the lawyer works in. The buyers who most need one are the ones
  /// least likely to read a TRNC contract, so this is a filter, not decoration.
  languages String[] @default([])
  /// How the lawyer charges — indicative only; the binding number is per quote.
  feeModel  String?  @map("fee_model")
  feeNote   String?  @map("fee_note")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lawyer_profiles")
}

/// A quote request from one side of a deal to one lawyer, and what became of it
/// (Plan §10.2 "quote/accept flow").
///
/// Scoped to the REQUESTER, not the deal: buyer and seller each engage their own
/// lawyer, and accepting one must never hand the other side's lawyer access to
/// the room. The partial unique index below enforces one accepted engagement per
/// requester per deal, which is what stops a second acceptance quietly adding a
/// second lawyer to the same side.
model LegalEngagement {
  id                String                @id @default(cuid())
  dealId            String                @map("deal_id")
  lawyerUserId      String                @map("lawyer_user_id")
  requestedByUserId String                @map("requested_by_user_id")
  /// The pipeline stage the request was made at — recorded because the stage is
  /// what authorised it (§2.2 injection points), so a later config change must
  /// not rewrite the history of why this was allowed.
  stageKey          String                @map("stage_key")
  status            LegalEngagementStatus @default(requested)
  scope             String?
  quoteAmount       Decimal?              @map("quote_amount") @db.Decimal(14, 2)
  quoteCurrency     String?               @map("quote_currency")
  quoteNote         String?               @map("quote_note")
  quotedAt          DateTime?             @map("quoted_at")
  respondedAt       DateTime?             @map("responded_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  deal        Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lawyer      User @relation("LegalEngagementLawyer", fields: [lawyerUserId], references: [id])
  requestedBy User @relation("LegalEngagementRequester", fields: [requestedByUserId], references: [id])

  @@unique([dealId, lawyerUserId, requestedByUserId])
  @@index([lawyerUserId, status])
  @@index([dealId])
  @@map("legal_engagements")
}

/// Lateral roles (lawyer, furniture, movers…) — empty at launch, the super-app seam (Plan §2.2).
model ServiceProvider {
  id                 String             @id @default(cuid())
  userId             String             @map("user_id")
  serviceType        ServiceType        @map("service_type")
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  pricingModel       String?            @map("pricing_model")
  regions            String[]           @default([])
  metadata           Json?
  createdAt          DateTime           @default(now()) @map("created_at")
  deletedAt          DateTime?          @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceType])
  @@map("service_providers")
}

// ─────────────────────── verification engine (Plan §4) ───────────────────────

model VerificationRequirement {
  id           String              @id @default(cuid())
  roleId       String?             @map("role_id")
  context      VerificationContext
  documentType String              @map("document_type")
  isRequired   Boolean             @default(true) @map("is_required")
  titleI18n    Json                @map("title_i18n")
  helpI18n     Json?               @map("help_i18n")
  sortOrder    Int                 @default(0) @map("sort_order")

  role Role? @relation(fields: [roleId], references: [id])

  @@map("verification_requirements")
}

model VerificationItem {
  id               String                 @id @default(cuid())
  entityType       VerificationEntityType @map("entity_type")
  entityId         String                 @map("entity_id")
  status           VerificationItemStatus @default(queued)
  claimedByAdminId String?                @map("claimed_by_admin_id")
  slaDueAt         DateTime               @map("sla_due_at")
  decidedAt        DateTime?              @map("decided_at")
  internalNotes    Json?                  @map("internal_notes")
  createdAt        DateTime               @default(now()) @map("created_at")

  @@index([status, slaDueAt])
  @@index([entityType, entityId])
  @@map("verification_items")
}

model Document {
  id               String            @id @default(cuid())
  ownerUserId      String            @map("owner_user_id")
  entityType       String            @map("entity_type")
  entityId         String            @map("entity_id")
  documentType     String            @map("document_type")
  storageKey       String            @map("storage_key")
  mime             String
  size             Int
  sha256           String
  status           DocumentStatus    @default(pending)
  rejectReasonCode RejectReasonCode? @map("reject_reason_code")
  rejectNote       String?           @map("reject_note")
  uploadedAt       DateTime          @default(now()) @map("uploaded_at")
  deletedAt        DateTime?         @map("deleted_at")

  owner         User           @relation(fields: [ownerUserId], references: [id])
  dealDocuments DealDocument[]
  mandateFor    Property[]     @relation("PropertyMandate")
  contract      Contract?

  @@index([sha256]) // same-document-across-accounts fraud signal (Plan §4)
  @@index([entityType, entityId])
  @@map("documents")
}

// ─────────────────────── properties & projects ───────────────────────

model Region {
  id       String  @id @default(cuid())
  parentId String? @map("parent_id")
  nameI18n Json    @map("name_i18n")
  slug     String  @unique
  lat      Float?
  lng      Float?

  parent     Region?    @relation("RegionTree", fields: [parentId], references: [id])
  children   Region[]   @relation("RegionTree")
  properties Property[]
  projects   Project[]

  @@map("regions")
}

model Property {
  id                      String         @id @default(cuid())
  kind                    PropertyKind
  createdByUserId         String         @map("created_by_user_id")
  onBehalfOfOwnerId       String?        @map("on_behalf_of_owner_id")
  mandateDocumentId       String?        @map("mandate_document_id")
  titleI18n               Json           @map("title_i18n")
  descriptionI18n         Json           @map("description_i18n")
  regionId                String         @map("region_id")
  district                String?
  lat                     Float?
  lng                     Float?
  priceAmount             Decimal        @map("price_amount") @db.Decimal(14, 2)
  priceCurrency           String         @map("price_currency")
  priceBaseGbp            Decimal        @map("price_base_gbp") @db.Decimal(14, 2)
  bedrooms                Int?
  bathrooms               Int?
  areaM2                  Float?         @map("area_m2")
  plotM2                  Float?         @map("plot_m2")
  deedType                DeedType       @default(na) @map("deed_type")
  furnished               Boolean        @default(false)
  features                Json?
  status                  PropertyStatus @default(draft)
  // §13.4/§13.5 mediated-resale pricing (buyer-pays): list = ask + band + commission
  platformProfitGbp       Decimal?       @map("platform_profit_gbp") @db.Decimal(14, 2)
  agentCommissionGbp      Decimal?       @map("agent_commission_gbp") @db.Decimal(14, 2)
  listPriceGbp            Decimal?       @map("list_price_gbp") @db.Decimal(14, 2)
  publishedByAgentId      String?        @map("published_by_agent_id")
  /// §8/§9 featured placement. A boost only ever reorders LIVE listings —
  /// it can never put an unverified one in front of a buyer.
  featuredUntil           DateTime?      @map("featured_until")
  availabilityConfirmedAt DateTime?      @map("availability_confirmed_at")
  viewCount               Int            @default(0) @map("view_count")
  saveCount               Int            @default(0) @map("save_count")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  deletedAt               DateTime?      @map("deleted_at")

  createdBy       User                     @relation("PropertyCreator", fields: [createdByUserId], references: [id])
  onBehalfOfOwner User?                    @relation("PropertyOwner", fields: [onBehalfOfOwnerId], references: [id])
  mandateDocument Document?                @relation("PropertyMandate", fields: [mandateDocumentId], references: [id])
  region          Region                   @relation(fields: [regionId], references: [id])
  media           PropertyMedia[]
  priceChanges    PropertyPriceChange[]
  viewEvents      PropertyViewEvent[]
  recommendations PropertyRecommendation[] @relation("RecommendationSource")
  recommendedBy   PropertyRecommendation[] @relation("RecommendationTarget")
  favorites       Favorite[]
  conversations   Conversation[]
  viewings        Viewing[]
  offers          Offer[]
  deals           Deal[]

  @@index([status, regionId, priceBaseGbp])
  @@index([lat, lng])
  @@map("properties")
}

model PropertyMedia {
  id         String    @id @default(cuid())
  propertyId String    @map("property_id")
  type       MediaType @default(photo)
  url        String
  phash      String? // perceptual hash for duplicate detection (Plan §2.4)
  sortOrder  Int       @default(0) @map("sort_order")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([phash])
  @@map("property_media")
}

/// One row per listing detail view. `properties.view_count` stays as the
/// lifetime counter; this table is what makes views a *time series* — the
/// analytics funnel (§6.7) reads it, and the co-visitation recommender (§8)
/// is built on exactly this shape.
model PropertyViewEvent {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  /// null for signed-out visitors — most traffic, and still valid supply/demand signal
  viewerId   String?  @map("viewer_id")
  /// Per-browser id from the `pv_sid` cookie. Signed-out browsing is the bulk of
  /// a portal's traffic, so co-visitation (§8) would see almost nothing without it.
  sessionKey String?  @map("session_key")
  /// `propertyId:identity:timeBucket`, unique — this is what makes one visit one
  /// view under concurrency. Null when the visitor has no identity to dedupe on.
  dedupeKey  String?  @unique @map("dedupe_key")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  viewer   User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([viewerId, createdAt])
  @@index([sessionKey, createdAt])
  @@map("property_view_events")
}

/// Precomputed "viewers of X also viewed Y" (Plan §8 recommendation v1).
/// Materialised nightly rather than computed per request: the pairwise scan is
/// far too heavy for a page load, and the result barely moves hour to hour.
model PropertyRecommendation {
  propertyId    String   @map("property_id")
  recommendedId String   @map("recommended_id")
  /// co-visitation strength, 0–1 (cosine over distinct viewers)
  score         Float
  /// co-visit count behind the score — kept so a weak signal is auditable
  coViews       Int      @map("co_views")
  rank          Int
  computedAt    DateTime @default(now()) @map("computed_at")

  property    Property @relation("RecommendationSource", fields: [propertyId], references: [id], onDelete: Cascade)
  recommended Property @relation("RecommendationTarget", fields: [recommendedId], references: [id], onDelete: Cascade)

  @@id([propertyId, recommendedId])
  @@index([propertyId, rank])
  @@map("property_recommendations")
}

model Project {
  id              String        @id @default(cuid())
  developerUserId String        @map("developer_user_id")
  nameI18n        Json          @map("name_i18n")
  regionId        String        @map("region_id")
  lat             Float?
  lng             Float?
  descriptionI18n Json          @map("description_i18n")
  deliveryDate    DateTime?     @map("delivery_date")
  paymentPlans    Json?         @map("payment_plans")
  status          ProjectStatus @default(draft)
  createdAt       DateTime      @default(now()) @map("created_at")
  deletedAt       DateTime?     @map("deleted_at")

  developer     User            @relation(fields: [developerUserId], references: [id])
  region        Region          @relation(fields: [regionId], references: [id])
  media         ProjectMedia[]
  units         ProjectUnit[]
  updates       ProjectUpdate[]
  conversations Conversation[]

  @@map("projects")
}

model ProjectMedia {
  id        String    @id @default(cuid())
  projectId String    @map("project_id")
  type      MediaType @default(photo)
  url       String
  sortOrder Int       @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_media")
}

model ProjectUnit {
  id            String     @id @default(cuid())
  projectId     String     @map("project_id")
  unitNo        String     @map("unit_no")
  type          String?
  bedrooms      Int?
  areaM2        Float?     @map("area_m2")
  floor         Int?
  priceAmount   Decimal    @map("price_amount") @db.Decimal(14, 2)
  priceCurrency String     @map("price_currency")
  status        UnitStatus @default(available)
  planMediaId   String?    @map("plan_media_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deals   Deal[]

  @@unique([projectId, unitNo])
  @@map("project_units")
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  titleI18n   Json     @map("title_i18n")
  bodyI18n    Json     @map("body_i18n")
  media       Json?
  publishedAt DateTime @default(now()) @map("published_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_updates")
}

// ─────────────────────── discovery ───────────────────────

model SavedSearch {
  id           String       @id @default(cuid())
  userId       String       @map("user_id")
  name         String?
  query        Json
  alertChannel AlertChannel @default(email) @map("alert_channel")
  lastAlertAt  DateTime?    @map("last_alert_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_searches")
}

/// Every price change on a live listing (Plan §6.1 "price-drop notifications
/// on favorites"). Recorded as a row rather than a mutable "previousPrice"
/// column so a listing that drifts down over weeks keeps its whole trajectory —
/// which is what a buyer actually wants to see, and what market insights will
/// need later.
///
/// Base GBP is stored alongside the quoted amount because listings are priced
/// in several currencies: comparing a drop across them is only meaningful in
/// the common base, and re-converting historic amounts at today's FX rate
/// would invent price movements that never happened.
model PropertyPriceChange {
  id              String   @id @default(cuid())
  propertyId      String   @map("property_id")
  oldAmount       Decimal  @map("old_amount") @db.Decimal(14, 2)
  newAmount       Decimal  @map("new_amount") @db.Decimal(14, 2)
  currency        String
  oldBaseGbp      Decimal  @map("old_base_gbp") @db.Decimal(14, 2)
  newBaseGbp      Decimal  @map("new_base_gbp") @db.Decimal(14, 2)
  /// Signed percentage against the base price; negative is a reduction.
  changePct       Decimal  @map("change_pct") @db.Decimal(6, 2)
  changedByUserId String?  @map("changed_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@map("property_price_changes")
}

model Favorite {
  userId      String    @map("user_id")
  propertyId  String    @map("property_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Last price-drop alert sent for this pairing, so a listing that keeps
  /// falling notifies once per drop rather than once per job run.
  lastAlertAt DateTime? @map("last_alert_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@map("favorites")
}

// ─────────────────────── chat ───────────────────────

model Conversation {
  id         String   @id @default(cuid())
  propertyId String?  @map("property_id")
  projectId  String?  @map("project_id")
  dealId     String?  @map("deal_id")
  createdAt  DateTime @default(now()) @map("created_at")

  property     Property?                 @relation(fields: [propertyId], references: [id])
  project      Project?                  @relation(fields: [projectId], references: [id])
  deal         Deal?                     @relation(fields: [dealId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String @map("conversation_id")
  userId         String @map("user_id")
  roleInConvo    String @map("role_in_convo")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  body           String
  bodyScrubbed   Boolean   @default(false) @map("body_scrubbed") // contact-info masking applied (Plan §2.4)
  attachments    Json?
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─────────────────────── viewings & offers ───────────────────────

model Viewing {
  id          String        @id @default(cuid())
  propertyId  String        @map("property_id")
  customerId  String        @map("customer_id")
  hostUserId  String        @map("host_user_id")
  scheduledAt DateTime      @map("scheduled_at")
  status      ViewingStatus @default(requested)
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])
  customer User     @relation("ViewingCustomer", fields: [customerId], references: [id])
  host     User     @relation("ViewingHost", fields: [hostUserId], references: [id])

  @@map("viewings")
}

model Offer {
  id            String      @id @default(cuid())
  propertyId    String      @map("property_id")
  customerId    String      @map("customer_id")
  amount        Decimal     @db.Decimal(14, 2)
  currency      String
  termsNote     String?     @map("terms_note")
  status        OfferStatus @default(submitted)
  parentOfferId String?     @map("parent_offer_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  property      Property @relation(fields: [propertyId], references: [id])
  customer      User     @relation(fields: [customerId], references: [id])
  parentOffer   Offer?   @relation("OfferCounter", fields: [parentOfferId], references: [id])
  counterOffers Offer[]  @relation("OfferCounter")

  @@map("offers")
}

// ─────────────────────── deals (Plan §7) ───────────────────────

model PipelineTemplate {
  id     String   @id @default(cuid())
  /// resolution key: `purchase`, `rental`, `project_purchase` (§6.3 off-plan units).
  /// Several templates can share a DealKind — a project-unit deal is still kind=purchase.
  key    String   @unique
  kind   DealKind
  stages Json // ordered PipelineStageDef[] incl. injectable_service_types

  @@map("pipeline_templates")
}

model Deal {
  id              String     @id @default(cuid())
  propertyId      String?    @map("property_id")
  projectUnitId   String?    @map("project_unit_id")
  kind            DealKind
  status          DealStatus @default(active)
  currentStageKey String     @map("current_stage_key")
  createdAt       DateTime   @default(now()) @map("created_at")
  completedAt     DateTime?  @map("completed_at")

  property      Property?      @relation(fields: [propertyId], references: [id])
  projectUnit   ProjectUnit?   @relation(fields: [projectUnitId], references: [id])
  parties       DealParty[]
  stages        DealStage[]
  documents     DealDocument[]
  snapshot      DealSnapshot?
  events        DealEvent[]
  ratings       Rating[]
  disputes      Dispute[]
  conversations Conversation[]
  contracts     Contract[]
  legalEngagements LegalEngagement[]

  @@map("deals")
}

model DealParty {
  dealId    String        @map("deal_id")
  userId    String        @map("user_id")
  partyRole DealPartyRole @map("party_role")
  joinedAt  DateTime      @default(now()) @map("joined_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([dealId, userId, partyRole])
  @@map("deal_parties")
}

model DealStage {
  id          String      @id @default(cuid())
  dealId      String      @map("deal_id")
  stageKey    String      @map("stage_key")
  status      StageStatus @default(pending)
  completedAt DateTime?   @map("completed_at")
  completedBy String?     @map("completed_by")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, stageKey])
  @@map("deal_stages")
}

model DealDocument {
  dealId     String @map("deal_id")
  documentId String @map("document_id")
  stageKey   String @map("stage_key")

  deal     Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id])

  @@id([dealId, documentId])
  @@map("deal_documents")
}

/// Frozen at offer acceptance (Plan §7): immutable record of what was agreed.
model DealSnapshot {
  dealId           String  @id @map("deal_id")
  propertySnapshot Json    @map("property_snapshot")
  priceAgreed      Decimal @map("price_agreed") @db.Decimal(14, 2)
  currency         String
  commissionSplit  Json?   @map("commission_split")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("deal_snapshot")
}

/// Immutable timeline — never updated or deleted, only appended.
model DealEvent {
  id        String   @id @default(cuid())
  dealId    String   @map("deal_id")
  actorId   String?  @map("actor_id")
  eventType String   @map("event_type")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
  @@map("deal_events")
}

// ─────────────────────── reputation ───────────────────────

model Rating {
  id         String    @id @default(cuid())
  dealId     String    @map("deal_id")
  raterId    String    @map("rater_id")
  rateeId    String    @map("ratee_id")
  stars      Int
  tags       String[]  @default([])
  comment    String?
  revealedAt DateTime? @map("revealed_at") // both-submit-or-14-days rule (Plan §6.5)
  createdAt  DateTime  @default(now()) @map("created_at")

  /// Moderation (§13.2). Set when an admin upholds a report: the comment stops
  /// being served publicly, but `stars` and `tags` still count towards the
  /// score. The original text is deliberately kept for the audit trail rather
  /// than overwritten — a removal has to be reviewable after the fact.
  commentRemovedAt     DateTime? @map("comment_removed_at")
  commentRemovedReason String?   @map("comment_removed_reason")

  deal    Deal           @relation(fields: [dealId], references: [id])
  rater   User           @relation("RatingRater", fields: [raterId], references: [id])
  ratee   User           @relation("RatingRatee", fields: [rateeId], references: [id])
  reports ReviewReport[]

  @@unique([dealId, raterId, rateeId])
  @@map("ratings")
}

/// A profile owner flagging a review about them (Plan §13.2). Owners can never
/// delete a review; reporting it to an admin is the only lever they have.
model ReviewReport {
  id                String             @id @default(cuid())
  ratingId          String             @map("rating_id")
  reportedByUserId  String             @map("reported_by_user_id")
  reason            String
  status            ReviewReportStatus @default(open)
  resolutionNote    String?            @map("resolution_note")
  resolvedByAdminId String?            @map("resolved_by_admin_id")
  resolvedAt        DateTime?          @map("resolved_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  rating     Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  reportedBy User   @relation("ReviewReportReporter", fields: [reportedByUserId], references: [id])

  /// One report per owner per review — re-reporting the same comment must not
  /// let an owner flood the queue until an admin gives in.
  @@unique([ratingId, reportedByUserId])
  @@index([status])
  @@map("review_reports")
}

/// Identity documents belonging to a banned account (Plan §13.2 "because
/// identities are verified, the ban is durable").
///
/// Matching is by file hash, which catches re-uploading the *same* file and
/// nothing more — a re-photographed passport hashes differently. The durable
/// part of the ban is therefore the human verification step, where this is
/// surfaced to the reviewing admin, not an automatic block at signup. Recorded
/// on ban and removed on reinstatement, so a reversed ban does not lock someone
/// out permanently.
model BannedIdentity {
  id           String   @id @default(cuid())
  bannedUserId String   @map("banned_user_id")
  /// SHA-256 of the identity document as uploaded.
  sha256       String   @unique
  documentType String   @map("document_type")
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  bannedUser User @relation("BannedIdentityUser", fields: [bannedUserId], references: [id], onDelete: Cascade)

  @@index([bannedUserId])
  @@map("banned_identities")
}

/// A strike against a reviewer whose comment was removed (Plan §13.2).
/// Accumulating `moderation.warnings_before_ban` of these bans the account.
model UserWarning {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  issuedByAdminId String   @map("issued_by_admin_id")
  reason          String
  /// What produced the warning, so the ban decision is auditable end to end.
  sourceType      String   @default("review_report") @map("source_type")
  sourceId        String?  @map("source_id")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation("UserWarningTarget", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_warnings")
}

model Dispute {
  id                String        @id @default(cuid())
  dealId            String        @map("deal_id")
  openedBy          String        @map("opened_by")
  againstUserId     String        @map("against_user_id")
  reason            String
  status            DisputeStatus @default(open)
  resolutionNote    String?       @map("resolution_note")
  resolvedByAdminId String?       @map("resolved_by_admin_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id])

  @@map("disputes")
}

// ─────────────────────── notifications / audit / misc ───────────────────────

/// One row per channel delivery (Plan §6.6) — an `offer.received` that goes
/// in-app and by email is two rows, so a failure on one channel is visible
/// without hiding the delivery that did work.
model Notification {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  channel     NotificationChannel
  templateKey String              @map("template_key")
  payload     Json?
  sentAt      DateTime?           @map("sent_at")
  /// Set when the provider rejected the send, or when no provider is configured
  /// for the channel — the row stays as the record of what was attempted.
  failedAt    DateTime?           @map("failed_at")
  error       String?
  readAt      DateTime?           @map("read_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

/// Per-user channel opt-in, one row per notification category (Plan §6.6).
/// Sparse by design: a missing row means "platform defaults apply", so
/// changing a default later reaches everyone who never expressed a preference.
model NotificationPreference {
  userId   String                @map("user_id")
  /// templateKey prefix — `offer`, `viewing`, `deal`, `availability`, …
  category String
  channels NotificationChannel[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("notification_preferences")
}

/// Expo push tokens (Plan §6.6 "push (FCM via Expo)"). A device, not a session:
/// the token survives sign-out, so it is deleted explicitly on sign-out from
/// the mobile app rather than tied to a refresh token.
model PushToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  token      String   @unique
  platform   String   @default("unknown") // ios | android | web
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

enum ReferralStatus {
  /// invitee signed up; the qualifying action has not happened yet
  pending
  /// invitee published a verified listing — the reward is earned (§8)
  qualified
  /// invitee never qualified within the window
  expired
}

enum CreditStatus {
  available
  used
  expired
}

enum ContractKind {
  rental_tenancy
  agent_mandate
  /// Resale purchase (§7 purchase pipeline, `contract_signing`).
  purchase_sale
  /// Off-plan purchase of a project unit — same stage, materially different
  /// document: stage payments, a delivery date and snagging on handover.
  offplan_sale
}

enum ContractStatus {
  awaiting_signatures
  signed
  void
}

/// Platform-generated contract PDF + its typed signatures (Plan §7, §6.2).
/// The PDF itself is an ordinary `documents` row, so it inherits the private
/// bucket and signed-URL rules (§2.4) rather than inventing a second store.
model Contract {
  id         String         @id @default(cuid())
  kind       ContractKind
  status     ContractStatus @default(awaiting_signatures)
  dealId     String?        @map("deal_id")
  propertyId String?        @map("property_id")
  /// Set on an `agent_mandate` instead of `dealId`: a mandate is the instrument
  /// that authorises an agent to market a property (§13.4), signed long before
  /// any deal exists. Exactly one of `dealId` / `assignmentId` is populated.
  assignmentId String?      @map("assignment_id")
  documentId String         @unique @map("document_id")
  /// Frozen terms the PDF was rendered from — the PDF is the artefact, this is
  /// the queryable record of what was actually agreed.
  terms      Json
  createdAt  DateTime       @default(now()) @map("created_at")
  signedAt   DateTime?      @map("signed_at")

  deal       Deal?               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  document   Document            @relation(fields: [documentId], references: [id])
  signatures ContractSignature[]

  @@index([dealId])
  @@index([assignmentId])
  @@map("contracts")
}

/// Typed-signature e-sign (Plan §6.2 "simple typed-signature + audit trail at
/// launch"). One row per required signatory; `signedAt` null means outstanding.
model ContractSignature {
  id         String    @id @default(cuid())
  contractId String    @map("contract_id")
  userId     String    @map("user_id")
  /// party_role at signing time, frozen — roles can change, a signature cannot
  partyRole  String    @map("party_role")
  /// what the signatory typed; the legal weight of a typed signature is the
  /// audit trail around it, so ip and timestamp are captured with it
  typedName  String?   @map("typed_name")
  signedAt   DateTime? @map("signed_at")
  ip         String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([contractId, userId])
  @@map("contract_signatures")
}

/// Invite tracking (Plan §8 "unique invite codes per user").
/// One row per invitee, so `refereeId` is unique — a person can be referred
/// once, and a race between two codes resolves to whoever landed first.
model Referral {
  id                   String         @id @default(cuid())
  referrerId           String         @map("referrer_id")
  refereeId            String         @unique @map("referee_id")
  /// the code as typed at signup, kept even if the referrer's code is reissued
  code                 String
  status               ReferralStatus @default(pending)
  qualifiedAt          DateTime?      @map("qualified_at")
  /// what the invitee did to qualify it — a published listing id (§8)
  qualifyingPropertyId String?        @map("qualifying_property_id")
  createdAt            DateTime       @default(now()) @map("created_at")

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId, status])
  @@map("referrals")
}

/// A featured-listing credit (Plan §8 reward, §9 `featured_slots` seam).
/// Earned, not bought — payments are Phase 3, so this table is deliberately
/// independent of any billing concept.
model FeaturedCredit {
  id               String       @id @default(cuid())
  userId           String       @map("user_id")
  status           CreditStatus @default(available)
  /// `referral` today; `purchase` when Phase 3 payments land
  source           String       @default("referral")
  referralId       String?      @map("referral_id")
  usedOnPropertyId String?      @map("used_on_property_id")
  usedAt           DateTime?    @map("used_at")
  expiresAt        DateTime?    @map("expires_at")
  createdAt        DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("featured_credits")
}

/// Append-only (Plan §2.4). No update/delete paths in application code.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model FxRate {
  base      String
  quote     String
  rate      Decimal  @db.Decimal(18, 8)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@id([base, quote])
  @@map("fx_rates")
}

// ─────────────────── marketplace core (§13) ───────────────────

/// Main-admin configurable platform settings (agent count, resale mode…).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// §13.5 price-range → fixed platform profit (GBP, buyer-pays).
model ProfitBand {
  id          String  @id @default(cuid())
  minPriceGbp Decimal @map("min_price_gbp") @db.Decimal(14, 2)
  maxPriceGbp Decimal @map("max_price_gbp") @db.Decimal(14, 2)
  profitGbp   Decimal @map("profit_gbp") @db.Decimal(14, 2)
  active      Boolean @default(true)

  @@map("profit_bands")
}

model Plan {
  id       String  @id @default(cuid())
  key      String  @unique
  name     String
  roleKey  String  @map("role_key") // which user type this plan is for
  tier     Int     @default(1)
  active   Boolean @default(true)
  metadata Json?

  subscriptions Subscription[]

  @@map("plans")
}

/// Admin-granted until Phase 3 payments (§13.3 decision).
model Subscription {
  id               String             @id @default(cuid())
  userId           String             @map("user_id")
  planId           String             @map("plan_id")
  status           SubscriptionStatus @default(active)
  startsAt         DateTime           @default(now()) @map("starts_at")
  endsAt           DateTime?          @map("ends_at")
  grantedByAdminId String?            @map("granted_by_admin_id")
  createdAt        DateTime           @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@map("subscriptions")
}

/// §13.4 find-my-agent: owner invites agents to work a private resale.
/// The agent NEVER receives owner contact details.
model AgentAssignment {
  id          String           @id @default(cuid())
  propertyId  String           @map("property_id")
  ownerUserId String           @map("owner_user_id")
  agentUserId String           @map("agent_user_id")
  termMonths  Int              @map("term_months")
  status      AssignmentStatus @default(invited)
  invitedAt   DateTime         @default(now()) @map("invited_at")
  respondedAt DateTime?        @map("responded_at")
  expiresAt   DateTime         @map("expires_at")

  @@index([agentUserId, status])
  @@index([propertyId, status])
  @@map("agent_assignments")
}

// ─────────────────────── auth support ───────────────────────

/// Rotating refresh tokens (Plan §2.1: access 15min / refresh 30d rotating).
/// Only the sha256 of the token is stored; rotation revokes the used token.
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  ip                String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  phone     String
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, createdAt])
  @@map("otp_codes")
}
