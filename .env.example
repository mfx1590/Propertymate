# ---- Database ----
DATABASE_URL=postgresql://propverify:propverify@localhost:5432/propverify?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Meilisearch ----
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev_master_key_change_me

# ---- Object storage (MinIO locally, Cloudflare R2 in prod) ----
# MINIO_PORT / MINIO_CONSOLE_PORT override the host ports when the 9000s are
# reserved by Windows (Hyper-V/WSL); keep S3_ENDPOINT and S3_PUBLIC_URL in step.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=propverify
S3_SECRET_KEY=propverify_secret
S3_BUCKET_MEDIA=media
S3_BUCKET_DOCUMENTS=documents
S3_PUBLIC_URL=http://localhost:9000/media

# ---- Auth ----
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- OTP provider ('mock' logs codes; 'twilio' for production) ----
OTP_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- API ----
API_PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Notification channels (Plan §6.6) ----
# Every external channel degrades to a logged "skipped" when unset, so dev and
# CI exercise the full fan-out without credentials. Push needs nothing: Expo's
# push service is keyless, it only needs a device to have registered a token.
RESEND_API_KEY=
EMAIL_FROM=PropVerify <noreply@propverify.local>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Observability ----
LOG_LEVEL=debug
# SENTRY_DSN=   # set to enable error tracking (Phase 3)
