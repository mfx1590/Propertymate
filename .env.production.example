# PropVerify — production/test deployment.
# Copy to .env.production on the server and fill in. NEVER commit the filled copy.
#
#   cp .env.production.example .env.production
#   # generate the three secrets:
#   openssl rand -base64 32

# ---- Domains (must already point at this server's IP) ----
APP_DOMAIN=app.ncresale.com
API_DOMAIN=api.ncresale.com

# ---- Database ----
POSTGRES_USER=propverify
POSTGRES_DB=propverify
POSTGRES_PASSWORD=CHANGE_ME

# ---- Search ----
MEILI_MASTER_KEY=CHANGE_ME

# ---- Object storage (MinIO in-stack; swap for R2 when it matters) ----
S3_ACCESS_KEY=propverify
S3_SECRET_KEY=CHANGE_ME

# ---- Auth ----
# Both must be long random strings. Changing them signs everyone out.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# 'mock' logs OTP codes to the API container log instead of sending SMS —
# correct for a test deployment, and the only way to sign in without Twilio.
# Read a code with: docker compose -f docker-compose.prod.yml logs -f api
OTP_PROVIDER=mock

# ---- First boot ----
# Set true for the very first `up`, then set back to false. Seeds roles,
# permissions, verification requirements, regions, pipelines and the admin user.
SEED_ON_BOOT=false

# ---- Optional ----
LOG_LEVEL=info
# Notification channels degrade to a recorded "skipped" while these are empty.
RESEND_API_KEY=
EMAIL_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SENTRY_DSN=
